<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Dashboard"/><%@ include file="_top.jsp" %>
<c:choose>
  <c:when test="${currentUser.roleName eq 'JOB_SEEKER'}">
    <section class="welcome-banner seeker-banner"><div><p class="eyebrow">YOUR NEXT MOVE</p><h1>Good to see you, <c:out value="${currentUser.name}"/>.</h1><p><c:out value="${settings['portal.welcome']}" default="Find a role that fits your goals and keep every application in view."/></p><a class="button light" href="<c:out value='${pageContext.request.contextPath}'/>/jobs">Explore opportunities <span aria-hidden="true">→</span></a></div><div class="banner-art" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three">↗</span><span class="banner-spark">✦</span></div></section>
    <div class="stat-grid"><article class="stat-card"><span class="stat-icon blue-icon">⌕</span><div><span>Open opportunities</span><strong><c:out value="${jobCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon violet-icon">▤</span><div><span>Your applications</span><strong><c:out value="${applicationCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon green-icon">✦</span><div><span>Profile strength</span><strong><c:choose><c:when test="${not empty currentUser.title and not empty currentUser.location and not empty currentUser.about}">Strong</c:when><c:otherwise>Building</c:otherwise></c:choose></strong></div></article></div>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">KEEP THE MOMENTUM</p><h2>Your applications</h2><p>Follow the status of every role you have applied for.</p></div><a class="text-link" href="<c:out value='${pageContext.request.contextPath}'/>/jobs">Find more roles →</a></div>
      <c:choose><c:when test="${empty applications}"><div class="empty-state compact"><span class="empty-icon">↗</span><h3>Your next opportunity is out there</h3><p>Search open roles and send your first application.</p><a class="button primary" href="<c:out value='${pageContext.request.contextPath}'/>/jobs">Browse jobs</a></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Role</th><th>Company</th><th>Applied</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${applications}" var="app"><tr><td><strong><c:out value="${app.jobTitle}"/></strong></td><td><c:out value="${app.companyName}"/></td><td><c:out value="${app.appliedAt}"/></td><td><span class="pill <c:choose><c:when test='${app.status eq "REJECTED"}'>red</c:when><c:when test='${app.status eq "HIRED" or app.status eq "OFFER"}'>green</c:when><c:otherwise>blue</c:otherwise></c:choose>"><c:out value="${app.status.replace('_',' ')}"/></span></td><td><a class="text-link" href="<c:out value='${pageContext.request.contextPath}'/>/messages?applicationId=<c:out value='${app.id}'/>">Messages ↗</a><c:if test="${not empty app.resumeName}"><a class="text-link block-link" href="<c:out value='${pageContext.request.contextPath}'/>/resume?applicationId=<c:out value='${app.id}'/>">Resume ↓</a></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
    </section>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">A GOOD FIT FOR YOU</p><h2>Recommended opportunities</h2><p>Suggestions use your profile title and location.</p></div></div><c:choose><c:when test="${empty recommendedJobs}"><p class="muted">Add a professional title and location to your profile to improve job suggestions.</p></c:when><c:otherwise><div class="recommendation-list"><c:forEach items="${recommendedJobs}" var="job"><a class="recommendation-row" href="<c:out value='${pageContext.request.contextPath}'/>/jobs"><span class="company-mark"><c:out value="${job.companyName.substring(0,1)}"/></span><span><strong><c:out value="${job.title}"/></strong><small><c:out value="${job.companyName}"/> · <c:out value="${job.location}"/></small></span><span class="text-link">Explore →</span></a></c:forEach></div></c:otherwise></c:choose></section>
  </c:when>
  <c:when test="${currentUser.roleName eq 'EMPLOYER'}">
    <section class="welcome-banner employer-banner"><div><p class="eyebrow">YOUR TEAM, YOUR NEXT HIRE</p><h1>Build a team that moves you forward.</h1><p>Publish roles, review applicants, and keep conversations in one place.</p><a class="button light" href="#create-job">Post a job <span aria-hidden="true">→</span></a></div><div class="banner-art" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three">✦</span><span class="banner-spark">↗</span></div></section>
    <div class="stat-grid"><article class="stat-card"><span class="stat-icon blue-icon">▤</span><div><span>Your postings</span><strong><c:out value="${jobCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon violet-icon">◎</span><div><span>Applications received</span><strong><c:out value="${applicationCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon green-icon">✓</span><div><span>Review queue</span><strong><c:out value="${applications.size()}"/></strong></div></article></div>
    <section class="panel analytics-panel"><div class="panel-heading"><div><p class="eyebrow">CANDIDATE PIPELINE</p><h2>Application status</h2><p>Current applications across your job postings.</p></div></div><c:choose><c:when test="${empty statusMetrics}"><p class="muted">Your applicant status chart will appear when candidates apply.</p></c:when><c:otherwise><div class="bar-chart"><c:forEach items="${statusMetrics}" var="metric"><div class="bar-row"><span><c:out value="${metric.label}"/></span><div class="bar-track"><i style="width:<c:out value='${metric.percent}'/>%"></i></div><strong><c:out value="${metric.value}"/></strong></div></c:forEach></div></c:otherwise></c:choose></section>
    <section class="panel" id="create-job"><div class="panel-heading"><div><p class="eyebrow">GROW YOUR TEAM</p><h2>Post a new role</h2><p>New postings go live after an administrator approves them.</p></div></div>
      <form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/employer/jobs" class="form-grid"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="create">
        <label>Job title<input required maxlength="100" name="title" placeholder="e.g. Senior Product Designer"></label><label>Category<select name="category" required><option value="">Choose category</option><option>Design</option><option>Engineering</option><option>Product</option><option>Marketing</option><option>Operations</option><option>Data</option></select></label>
        <label>Location<input required maxlength="100" name="location" placeholder="City, country or remote"></label><label>Employment type<select name="employmentType"><option value="FULL_TIME">Full time</option><option value="PART_TIME">Part time</option><option value="CONTRACT">Contract</option><option value="INTERNSHIP">Internship</option></select></label>
        <label>Work mode<select name="workMode"><option value="HYBRID">Hybrid</option><option value="ONSITE">On site</option><option value="REMOTE">Remote</option></select></label><label>Salary range<input maxlength="80" name="salary" placeholder="e.g. ₹12–18 LPA"></label>
        <label class="span-two">Skills and tags<input maxlength="180" name="tags" placeholder="Java, SQL, collaboration"></label><label class="span-two">Role description<textarea required minlength="25" maxlength="4000" rows="4" name="description" placeholder="What will this person do? What experience will help them succeed?"></textarea></label>
        <div class="span-two"><button class="button primary" type="submit">Submit for review</button></div>
      </form>
    </section>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">MANAGE YOUR OPENINGS</p><h2>Job postings</h2><p>Edit a role to send it back through review.</p></div></div>
      <c:choose><c:when test="${empty jobs}"><div class="empty-state compact"><h3>No postings yet</h3><p>Your first listing will appear here after submission.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Role</th><th>Applicants</th><th>Review status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${jobs}" var="job"><tr><td><strong><c:out value="${job.title}"/></strong><small class="table-sub"><c:out value="${job.location}"/></small></td><td><c:out value="${job.applicantCount}"/></td><td><span class="pill <c:choose><c:when test='${job.status eq "APPROVED"}'>green</c:when><c:when test='${job.status eq "REJECTED"}'>red</c:when><c:otherwise>amber</c:otherwise></c:choose>"><c:out value="${job.status}"/></span></td><td><div class="inline-actions"><c:if test="${job.status ne 'CLOSED'}"><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/employer/jobs"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="close"><input type="hidden" name="jobId" value="<c:out value='${job.id}'/>"><button class="small-button" type="submit">Close</button></form></c:if><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/employer/jobs"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="delete"><input type="hidden" name="jobId" value="<c:out value='${job.id}'/>"><button class="small-button danger" type="submit">Delete</button></form><details class="edit-user"><summary class="small-button">Edit</summary><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/employer/jobs" class="edit-popover edit-job-form"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="update"><input type="hidden" name="jobId" value="<c:out value='${job.id}'/>"><label>Title<input required name="title" maxlength="100" value="<c:out value='${job.title}'/>"></label><label>Category<input required name="category" maxlength="60" value="<c:out value='${job.category}'/>"></label><label>Location<input required name="location" maxlength="100" value="<c:out value='${job.location}'/>"></label><label>Employment type<select name="employmentType"><c:forEach items="${['FULL_TIME','PART_TIME','CONTRACT','INTERNSHIP']}" var="type"><option value="<c:out value='${type}'/>" <c:if test="${job.employmentType eq type}">selected</c:if>><c:out value="${type}"/></option></c:forEach></select></label><label>Work mode<select name="workMode"><c:forEach items="${['ONSITE','HYBRID','REMOTE']}" var="mode"><option value="<c:out value='${mode}'/>" <c:if test="${job.workMode eq mode}">selected</c:if>><c:out value="${mode}"/></option></c:forEach></select></label><label>Salary<input name="salary" maxlength="80" value="<c:out value='${job.salary}'/>"></label><label>Tags<input name="tags" maxlength="180" value="<c:out value='${job.tags}'/>"></label><label>Description<textarea required minlength="25" name="description" maxlength="4000" rows="5"><c:out value="${job.description}"/></textarea></label><button class="button primary" type="submit">Save &amp; resubmit</button></form></details></div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
    </section>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">TALENT IN MOTION</p><h2>Applications</h2><p>Review candidates and update their progress.</p></div></div>
      <c:choose><c:when test="${empty applications}"><div class="empty-state compact"><p>Applications will appear here when candidates apply.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Role</th><th>Applied</th><th>Status</th><th>Update</th><th></th></tr></thead><tbody><c:forEach items="${applications}" var="app"><tr><td><strong><c:out value="${app.seekerName}"/></strong><small class="table-sub"><c:out value="${app.seekerTitle}"/></small></td><td><c:out value="${app.jobTitle}"/></td><td><c:out value="${app.appliedAt}"/></td><td><span class="pill blue"><c:out value="${app.status.replace('_',' ')}"/></span></td><td><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/applications" class="status-form"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="status"><input type="hidden" name="applicationId" value="<c:out value='${app.id}'/>"><select name="status" aria-label="Update application status"><option value="IN_REVIEW">In review</option><option value="SHORTLISTED">Shortlisted</option><option value="INTERVIEW">Interview</option><option value="OFFER">Offer</option><option value="HIRED">Hired</option><option value="REJECTED">Rejected</option></select><button class="small-button" type="submit">Save</button></form></td><td><a class="text-link" href="<c:out value='${pageContext.request.contextPath}'/>/messages?applicationId=<c:out value='${app.id}'/>">Message</a><c:if test="${not empty app.resumeName}"><a class="text-link block-link" href="<c:out value='${pageContext.request.contextPath}'/>/resume?applicationId=<c:out value='${app.id}'/>">Resume ↓</a></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
    </section>
  </c:when>
  <c:otherwise>
    <section class="welcome-banner admin-banner"><div><p class="eyebrow">PORTAL OPERATIONS</p><h1>Good morning, <c:out value="${currentUser.name}"/>.</h1><p>Keep the marketplace useful, safe, and moving forward.</p></div><div class="banner-art" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three">✦</span><span class="banner-spark">◎</span></div></section>
    <div class="stat-grid four-stats"><article class="stat-card"><span class="stat-icon blue-icon">♙</span><div><span>Accounts</span><strong><c:out value="${userCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon violet-icon">▤</span><div><span>All postings</span><strong><c:out value="${jobCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon green-icon">◎</span><div><span>Applications</span><strong><c:out value="${applicationCount}"/></strong></div></article><article class="stat-card"><span class="stat-icon amber-icon">◷</span><div><span>Awaiting review</span><strong><c:out value="${pendingJobCount}"/></strong></div></article></div>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">QUALITY CONTROL</p><h2>Job listings awaiting review</h2><p>Approve postings that meet marketplace standards.</p></div></div><c:choose><c:when test="${empty jobs}"><div class="empty-state compact"><span class="empty-icon">✓</span><h3>Review queue is clear</h3><p>New employer submissions will appear here.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Role</th><th>Company</th><th>Category</th><th>Submitted</th><th>Decision</th></tr></thead><tbody><c:forEach items="${jobs}" var="job"><tr><td><strong><c:out value="${job.title}"/></strong><small class="table-sub"><c:out value="${job.location}"/></small></td><td><c:out value="${job.companyName}"/></td><td><c:out value="${job.category}"/></td><td><c:out value="${job.submittedAt}"/></td><td><div class="inline-actions"><c:forEach items="${['APPROVED','REJECTED']}" var="decision"><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/admin/manage"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="job-status"><input type="hidden" name="id" value="<c:out value='${job.id}'/>"><input type="hidden" name="status" value="<c:out value='${decision}'/>"><button class="small-button <c:if test='${decision eq "REJECTED"}'>danger</c:if>" type="submit"><c:out value="${decision}"/></button></form></c:forEach></div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
    <div class="analytics-columns"><section class="panel analytics-panel"><div class="panel-heading"><div><p class="eyebrow">PORTAL HEALTH</p><h2>Application outcomes</h2><p>Current status across the marketplace.</p></div></div><div class="bar-chart"><c:forEach items="${statusMetrics}" var="metric"><div class="bar-row"><span><c:out value="${metric.label}"/></span><div class="bar-track"><i style="width:<c:out value='${metric.percent}'/>%"></i></div><strong><c:out value="${metric.value}"/></strong></div></c:forEach></div></section><section class="panel analytics-panel"><div class="panel-heading"><div><p class="eyebrow">LISTING REVIEW</p><h2>Posting status</h2><p>Review and publication counts.</p></div></div><div class="bar-chart"><c:forEach items="${jobReviewMetrics}" var="metric"><div class="bar-row"><span><c:out value="${metric.label}"/></span><div class="bar-track"><i class="violet-bar" style="width:<c:out value='${metric.percent}'/>%"></i></div><strong><c:out value="${metric.value}"/></strong></div></c:forEach></div></section></div>
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">PEOPLE &amp; ACCESS</p><h2>User management</h2><p>Review accounts, access status, and assigned roles.</p></div></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Access</th><th>Actions</th></tr></thead><tbody><c:forEach items="${users}" var="member"><tr><td><strong><c:out value="${member.name}"/></strong><small class="table-sub"><c:out value="${member.title}"/></small></td><td><c:out value="${member.email}"/></td><td><span class="pill blue"><c:out value="${member.roleName}"/></span></td><td><span class="pill <c:choose><c:when test='${member.active}'>green</c:when><c:otherwise>red</c:otherwise></c:choose>"><c:choose><c:when test="${member.active}">Active</c:when><c:otherwise>Disabled</c:otherwise></c:choose></span></td><td><c:if test="${member.id ne currentUser.id}"><div class="inline-actions"><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/admin/manage"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="user-active"><input type="hidden" name="id" value="<c:out value='${member.id}'/>"><input type="hidden" name="active" value="<c:out value='${not member.active}'/>"><button class="small-button" type="submit"><c:choose><c:when test="${member.active}">Disable</c:when><c:otherwise>Enable</c:otherwise></c:choose></button></form><details class="edit-user"><summary class="small-button">Edit</summary><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/admin/manage" class="edit-popover"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="user-update"><input type="hidden" name="id" value="<c:out value='${member.id}'/>"><label>Name<input name="name" required value="<c:out value='${member.name}'/>"></label><label>Email<input type="email" name="email" required value="<c:out value='${member.email}'/>"></label><label>Title<input name="title" value="<c:out value='${member.title}'/>"></label><label>Role<select name="role"><c:forEach items="${['JOB_SEEKER','EMPLOYER','ADMIN']}" var="role"><option value="<c:out value='${role}'/>" <c:if test="${member.roleName eq role}">selected</c:if>><c:out value="${role}"/></option></c:forEach></select></label><button class="button primary" type="submit">Save account</button></form></details><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/admin/manage" onsubmit="return confirm('Delete this account and its related records?');"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="user-delete"><input type="hidden" name="id" value="<c:out value='${member.id}'/>"><button class="small-button danger" type="submit">Delete</button></form></div></c:if></td></tr></c:forEach></tbody></table></div></section>
    <div class="two-column admin-lower"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">SYSTEM-WIDE</p><h2>Portal settings</h2><p>Update the shared welcome message and support contact.</p></div></div><form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/admin/manage" class="form-stack"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="settings"><label>Welcome message<input name="welcome" maxlength="180" value="<c:out value="${settings['portal.welcome']}"/>" placeholder="Welcome to TalentBridge"></label><label>Support email<input type="email" name="supportEmail" maxlength="254" value="<c:out value="${settings['portal.supportEmail']}"/>" placeholder="support@example.com"></label><button class="button primary" type="submit">Save settings</button></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">LIVE PULSE</p><h2>Recent activity</h2><p>Latest recorded portal events.</p></div></div><ul class="activity-list"><c:forEach items="${recentActivity}" var="item"><li><span class="activity-dot"></span><span><strong><c:out value="${item.description}"/></strong><small><c:out value="${item.createdAt}"/></small></span></li></c:forEach><c:if test="${empty recentActivity}"><li class="muted">No activity recorded yet.</li></c:if></ul></section></div>
  </c:otherwise>
</c:choose>
<%@ include file="_bottom.jsp" %>
