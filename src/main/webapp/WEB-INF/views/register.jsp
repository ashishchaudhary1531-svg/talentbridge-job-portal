<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create account · TalentBridge</title><link rel="stylesheet" href="<c:out value='${pageContext.request.contextPath}'/>/assets/portal.css"></head>
<body class="login-page"><main class="login-layout"><section class="login-story"><a class="brand brand-light" href="<c:out value='${pageContext.request.contextPath}'/>/login"><span class="brand-mark">T</span><span>TalentBridge<small>Find work that moves you</small></span></a><div><p class="eyebrow">MAKE YOUR NEXT CONNECTION</p><h1>One profile. More possibilities.</h1><p>Create a job seeker profile or join as an employer to start building your team.</p></div><span class="story-foot">Your journey starts with a good introduction.</span></section>
<section class="login-panel"><div class="login-card"><p class="eyebrow">GET STARTED</p><h2>Create your account</h2><p class="muted">Administrators are created by portal management.</p><c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if>
<form method="post" action="<c:out value='${pageContext.request.contextPath}'/>/register" class="form-stack"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><label>Account type<select name="role" id="accountRole"><option value="JOB_SEEKER" <c:if test="${param.role ne 'EMPLOYER'}">selected</c:if>>Job seeker</option><option value="EMPLOYER" <c:if test="${param.role eq 'EMPLOYER'}">selected</c:if>>Employer</option></select></label><label>Full name<input required maxlength="100" name="name" value="<c:out value='${param.name}'/>"></label><label>Email address<input type="email" required maxlength="254" name="email" autocomplete="email" value="<c:out value='${param.email}'/>"></label><label>Professional title<input maxlength="120" name="title" value="<c:out value='${param.title}'/>" placeholder="e.g. Product Designer"></label><label>Location<input maxlength="100" name="location" value="<c:out value='${param.location}'/>" placeholder="City, country or remote"></label><label id="companyField">Company name <span class="muted">(employers)</span><input maxlength="150" name="company" value="<c:out value='${param.company}'/>" placeholder="Your organization"></label><label>Password<input type="password" required minlength="8" maxlength="100" name="password" autocomplete="new-password"></label><label>Confirm password<input type="password" required minlength="8" maxlength="100" name="confirmPassword" autocomplete="new-password"></label><button class="button primary full" type="submit">Create account <span aria-hidden="true">→</span></button></form><p class="signup-line">Already have an account? <a href="<c:out value='${pageContext.request.contextPath}'/>/login">Sign in</a></p>
</div></section></main><script>const role=document.getElementById('accountRole'), company=document.getElementById('companyField');function syncCompany(){company.style.display=role.value==='EMPLOYER'?'grid':'none';company.querySelector('input').required=role.value==='EMPLOYER'}role.addEventListener('change',syncCompany);syncCompany();</script></body></html>
